# Cloudflare WAF — /etc/impetus/cloudflare-waf.env (chmod 600)
# Criar token: dash.cloudflare.com → My Profile → API Tokens
# Permissões: Zone → Firewall Services → Edit | Zone → Zone → Read
# Zone Resources: plataformaimpetus.com

CLOUDFLARE_API_TOKEN=PASTE_TOKEN_HERE
CLOUDFLARE_ZONE_NAME=plataformaimpetus.com
# Opcional se já souber o Zone ID (senão o script resolve):
# CLOUDFLARE_ZONE_ID=

IMPETUS_CF_WAF_SCANNER_BLOCK=true
IMPETUS_CF_AUTO_BAN_IPS=true
IMPETUS_CF_MAX_IP_RULES=200
