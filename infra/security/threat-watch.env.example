# IMPETUS Threat Watch — copiar para /etc/impetus/threat-watch.env (chmod 600)
# cp infra/security/threat-watch.env.example /etc/impetus/threat-watch.env

# --- WhatsApp (CallMeBot — cada pessoa regista o seu número) ---
# 1) Adiciona +34 621 07 32 45 aos contactos
# 2) Envia: "I allow callmebot to send me messages"
# 3) Recebes apikey — coloca no par phone:apikey abaixo (um por número)
# Docs: https://www.callmebot.com/blog/free-api-whatsapp-messages/
#
# Formato: DDI+DDD+número:apikey (vírgula entre destinatários)
IMPETUS_WHATSAPP_RECIPIENTS=5532985080209:PENDENTE,5532999509065:PENDENTE

# Legado (opcional, um só número):
# IMPETUS_WHATSAPP_PHONE=5532985080209
# IMPETUS_WHATSAPP_APIKEY=your_callmebot_apikey

# Alternativa: webhook genérico (n8n, Evolution API, Zapier)
# IMPETUS_ALERT_WEBHOOK_URL=https://your-n8n.example/webhook/impetus-threat

# --- IPs da equipa (nunca banir) ---
IMPETUS_TRUSTED_CIDRS=170.246.0.0/16,186.225.0.0/16,2804:2980::/32,2804:2484::/32,127.0.0.1,::1

# --- Acções ---
IMPETUS_AUTO_UFW_DENY=true
IMPETUS_NOTIFY_COOLDOWN_SEC=600
# WhatsApp só para alertas sérios (HIGH/CRITICAL). MEDIUM = bloqueia IP, sem WhatsApp.
IMPETUS_WHATSAPP_MIN_SEVERITY=HIGH
IMPETUS_WHATSAPP_COOLDOWN_SEC=3600
# Ruído de internet: só alerta 404 flood acima de N pedidos na janela
IMPETUS_404_FLOOD_THRESHOLD=50
# POST/PUT em paths aleatórios (ex. /graphql 301) — não notificar
IMPETUS_NOTIFY_HTTP_WRITE=false
IMPETUS_SSH_FAIL_THRESHOLD=3
IMPETUS_HTTP_PROBE_THRESHOLD=2

# --- Lockdown automático (Fase 2) — software offline se invasão multi-camada ---
IMPETUS_AUTO_LOCKDOWN_ENABLED=true
IMPETUS_BREACH_LAYER_WINDOW_SEC=900
IMPETUS_BREACH_MIN_LAYERS=2

# Reiniciar backend com observatory em incidente CRITICAL (cuidado — default off)
IMPETUS_AUTO_ENABLE_OBSERVATORY=false
