# IMPETUS — Pilha de segurança alinhada (copiar variáveis relevantes para backend/.env)
# Camadas: Cloudflare (rede) · fail2ban/threat-watch (servidor) · MFA/Turnstile (software)

# ── Cloudflare (infra — não são vars Node; activar via scripts) ──────────────
# 1. Conta Cloudflare + DNS proxy (nuvem laranja)
# 2. sudo bash infra/scripts/update-cloudflare-ips.sh
# 3. sudo bash infra/scripts/enable-cloudflare-proxy-mode.sh on   # após DNS na CF
# 4. Turnstile (opcional painel): https://dash.cloudflare.com → Turnstile

ADMIN_PORTAL_TURNSTILE_SITE_KEY=
ADMIN_PORTAL_TURNSTILE_SECRET_KEY=
ADMIN_PORTAL_HUMAN_CHECK_ENABLED=true

# ── MFA app cliente (2FA dentro do software) ─────────────────────────────────
IMPETUS_MFA_ENABLED=true
IMPETUS_MFA_MODE=on
IMPETUS_MFA_TOTP_ENABLED=true
IMPETUS_MFA_WEBAUTHN_ENABLED=true
IMPETUS_MFA_BACKUP_CODES_ENABLED=true
IMPETUS_MFA_DEVICE_TRUST_ENABLED=true
IMPETUS_MFA_DEVICE_TRUST_DAYS=14
IMPETUS_MFA_PILOT_ONLY=true
IMPETUS_MFA_PILOT_TENANTS=<uuid-empresa-1>,<uuid-empresa-2>
IMPETUS_MFA_CHALLENGE_TTL_MINUTES=10
IMPETUS_MFA_WEBAUTHN_RP_ID=srv1422313.hstgr.cloud
IMPETUS_MFA_WEBAUTHN_ORIGIN=https://srv1422313.hstgr.cloud
IMPETUS_MFA_ENCRYPTION_KEY=<openssl rand -base64 48>

# Piloto vs enterprise (se rollout=true, ignora PILOT_ONLY)
IMPETUS_ENTERPRISE_SECURITY_ROLLOUT=false

# ── Admin painel equipe — TOTP 2FA ───────────────────────────────────────────
IMPETUS_ADMIN_PORTAL_MFA_ENABLED=true

# ── Threat watch (servidor) — /etc/impetus/threat-watch.env ────────────────
# IMPETUS_AUTO_UFW_DENY=true
# IMPETUS_TRUSTED_CIDRS=170.246.0.0/16,186.225.0.0/16
